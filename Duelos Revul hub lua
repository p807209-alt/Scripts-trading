local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- 🔑 KEY CORRECTA
local CORRECT_KEY = "1234"

-- 👥 WHITELIST
local WHITELIST = {
    [12345678] = true,
    [87654321] = true,
}

-- 🔑 KEY DEL USUARIO (desde executor)
local userKey = getgenv().key

-- ❌ VALIDACIÓN (un solo mensaje)
if not WHITELIST[player.UserId] or userKey ~= CORRECT_KEY then
    player:Kick("Key requerida / No autorizado")
    return
end

-- ✅ ACCESO → HUB
loadstring(game:HttpGet("TU_LINK_AQUI"))()
