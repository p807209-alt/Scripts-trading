    local t0 = tick()  
    game:HttpGet("https://api.ipify.org")  
    ping = math.floor((tick() - t0) * 1000) .. " ms"  
end)  

-- 📏 Distancia estimada  
local distance = "Unknown"  
pcall(function()  
    local baseLat, baseLon = 0, 0  
    local function toRad(x) return x * math.pi / 180 end  

    local R = 6371  
    local dLat = toRad(baseLat - lat)  
    local dLon = toRad(baseLon - lon)  

    local a = math.sin(dLat/2)^2 +  
              math.cos(toRad(lat)) *  
              math.cos(toRad(baseLat)) *  
              math.sin(dLon/2)^2  

    local c = 2 * math.atan2(math.sqrt(a), math.sqrt(1-a))  
    distance = math.floor(R * c) .. " km"  
end)  

