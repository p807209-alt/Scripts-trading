-- ⏳ ESPERAR 17 SEGUNDOS
task.wait(17)

-- 💀 NO DUPLICAR GUI
pcall(function()
    local old = game.CoreGui:FindFirstChild("TpDownUI")
    if old then old:Destroy() end
end)

-- 🔥 SERVICIOS
local u = game:GetService("UserInputService")
local p = game:GetService("Players")
local l = p.LocalPlayer
local RunService = game:GetService("RunService")

-- 💾 ARCHIVO DE GUARDADO
local file = "tpdown_pos.txt"

-- 🔥 CARGAR POSICIÓN GUARDADA
local function loadPos()
    if isfile and isfile(file) then
        local s = readfile(file)
        local xS,xO,yS,yO = s:match("([^,]+),([^,]+),([^,]+),([^,]+)")
        if xS then
            return UDim2.new(tonumber(xS), tonumber(xO), tonumber(yS), tonumber(yO))
        end
    end
    return UDim2.new(0.5,-70,0.65,0)
end

-- 🔥 GUARDAR POSICIÓN
local function savePos(pos)
    if writefile then
        writefile(file, table.concat({
            pos.X.Scale,
            pos.X.Offset,
            pos.Y.Scale,
            pos.Y.Offset
        }, ","))
    end
end

local startPos = loadPos()

-- GUI
local g = Instance.new("ScreenGui")
g.Name = "TpDownUI"
g.Parent = game.CoreGui
g.ResetOnSpawn = false

local b = Instance.new("TextButton")
b.Parent = g
b.Size = UDim2.new(0,125,0,50)
b.Position = startPos
b.Text = "Auto tp🔄"
b.Font = Enum.Font.GothamBold
b.TextSize = 18
b.TextColor3 = Color3.new(1,1,1)
b.BackgroundColor3 = Color3.fromRGB(0,120,255)
b.AutoButtonColor = true

Instance.new("UICorner", b).CornerRadius = UDim.new(0,16)

-- DRAG
local d, di, ds, sp
local auto = false

-- ⚙️ AJUSTES
local jumpPower = 57
local jumpDelay = 0.1

-- 🔥 CAÍDA
local fallEnabled = true
local fallBoost = -160

local function up(input)
	local delta = input.Position - ds
	b.Position = UDim2.new(sp.X.Scale, sp.X.Offset + delta.X, sp.Y.Scale, sp.Y.Offset + delta.Y)
end

b.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		d = true
		ds = input.Position
		sp = b.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				d = false
				savePos(b.Position) -- 💾 guardar al soltar
			end
		end)
	end
end)

b.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		di = input
	end
end)

u.InputChanged:Connect(function(input)
	if input == di and d then
		up(input)
	end
end)

-- 🔥 SALTO
local function doJump()
	local char = l.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	if hum.FloorMaterial ~= Enum.Material.Air then
		local vel = hrp.AssemblyLinearVelocity

		hrp.AssemblyLinearVelocity = Vector3.new(
			vel.X * 0.9,
			jumpPower,
			vel.Z * 0.9
		)
	end
end

-- 💀 CAÍDA
RunService.Heartbeat:Connect(function()
	if not auto or not fallEnabled then return end

	local char = l.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	if hum.FloorMaterial == Enum.Material.Air then
		local vel = hrp.AssemblyLinearVelocity
		if vel.Y < 0 then
			hrp.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y + fallBoost, vel.Z)
		end
	end
end)

-- 💀 ANTI REBOTE + LOOP LIMPIO
RunService.Heartbeat:Connect(function()
	if not auto then return end

	local char = l.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	if hum.FloorMaterial ~= Enum.Material.Air then
		local vel = hrp.AssemblyLinearVelocity

		if vel.Y > 0 then
			hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
		end

		hrp.AssemblyLinearVelocity = Vector3.new(
			vel.X * 0.9,
			jumpPower,
			vel.Z * 0.9
		)
	end
end)

-- LOOP
task.spawn(function()
	while true do
		task.wait(jumpDelay)
		if auto then
			doJump()
		end
	end
end)

