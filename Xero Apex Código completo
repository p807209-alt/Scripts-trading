task.spawn(function()
    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")

    local NOMBRE_NUEVO = "Grok hub"
    local DISCORD_TUYO = "REVUL PREMIUM"

    local COLORS = {
        PurpleStart = Color3.fromRGB(120, 0, 255),
        PurpleMiddle = Color3.fromRGB(60, 0, 150),
        PurpleEnd = Color3.fromRGB(120, 0, 255)
    }

    local function lockStyle(v)
        if v:FindFirstAncestor("RobloxGui") or v:FindFirstAncestor("Chat") or v:FindFirstAncestor("MarcaXero") then
            return 
        end

        local function apply()
            pcall(function()
                if v:IsA("TextLabel") or v:IsA("TextButton") then
                    local t = v.Text or ""
                    if (t:find("REVUL") or t:find("REVUL")) and not t:find("Grok hub") then
                        local newText = t:gsub("REVUL HUB", NOMBRE_NUEVO)
                        newText = newText:gsub("REVUL HUB", NOMBRE_NUEVO)
                        newText = newText:gsub("REVUL", NOMBRE_NUEVO)
                        if v.Text ~= newText then v.Text = newText end
                    end
                    if t:find("discord.gg") and not t:find(DISCORD_TUYO) then
                        v.Visible = false
                    end
                    if v:IsA("TextButton") or v.Parent.Name:find("Top") or v.Parent.Name:find("Bar") then
                        v.TextColor3 = COLORS.TextWhite
                    end
                end

                if v:IsA("GuiObject") and v:FindFirstAncestorOfClass("ScreenGui") then
                    if v.BackgroundColor3.b > 0.5 and v.BackgroundColor3.r < 0.5 then
                        if v:IsA("Frame") or v:IsA("ScrollingFrame") then
                            v.BackgroundColor3 = COLORS.Background
                        elseif v:IsA("TextButton") or v:IsA("ImageButton") then
                            v.BackgroundColor3 = COLORS.ButtonDark
                            local s = v:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", v)
                            s.Color = COLORS.AccentBlue
                        end
                    end
                end
            end)
        end

        if v:IsA("GuiObject") then
            v:GetPropertyChangedSignal("BackgroundColor3"):Connect(apply)
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                v:GetPropertyChangedSignal("Text"):Connect(apply)
            end
        end
        apply()
    end

    game.DescendantAdded:Connect(function(obj) task.defer(function() lockStyle(obj) end) end)
    for _, v in ipairs(CoreGui:GetDescendants()) do lockStyle(v) end

    -- 🚀 EJECUTAR NOVA
    task.spawn(function()
loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/5f43c5a7d6b0a78eaf931dadba1c1d1f.lua"))()
end)

    -- 💎 MARCA PERSONAL
    local gui = Instance.new("ScreenGui", CoreGui)
    gui.Name = "MarcaXero"
    local text = Instance.new("TextLabel", gui)
    text.Size = UDim2.new(0, 300, 0, 25)
    text.Position = UDim2.new(0.5, -150, 0.4, 0)
    text.BackgroundTransparency = 1
    text.Text = DISCORD_TUYO
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 18
    local stroke = Instance.new("UIStroke", text)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(0,0,0)
end)

