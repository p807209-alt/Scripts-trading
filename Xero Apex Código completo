-- 🔥 CAMBIO NOVA → XERO APEX (HOOK LIGERO)
local function hookLabel(v)
    if v:IsA("TextLabel") then
        v:GetPropertyChangedSignal("Text"):Connect(function()
            pcall(function()
                if v.Text and v.Text:find("Nova") then
                    v.Text = v.Text:gsub("Nova Hub", "Xero Apex")
                    v.Text = v.Text:gsub("Nova", "Xero Apex")
                end
            end)
        end)

        -- aplicar inicial
        pcall(function()
            if v.Text and v.Text:find("Nova") then
                v.Text = v.Text:gsub("Nova Hub", "Xero Apex")
                v.Text = v.Text:gsub("Nova", "Xero Apex")
            end
        end)
    end
end

-- 🔥 OCULTAR SOLO UN DISCORD (ULTRA LIGERO)

local TARGET = "discord.gg/vhu5rhjq9u"

local function hideIfMatch(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        local t = obj.Text and string.lower(obj.Text)
        if t and t:find(TARGET) then
            obj.TextTransparency = 1
            obj.TextStrokeTransparency = 1
            obj.BackgroundTransparency = 1
        end
    end
end

-- 🔥 DETECTAR NUEVOS (SIN LAG)
