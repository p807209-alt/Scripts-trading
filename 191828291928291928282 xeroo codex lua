    Enabled = false,
    UI = nil,
    LastUsed = 0,
    Debounce = false,
    FileName = "Kawatan_MedusaMaster.json",
    Opponents = {},
    Connections = {}
}

-- ===================== GUARDADO DE ESTADO =====================
local function SaveConfig()
    if not MedusaConfig.UI then return end
    local data = {
        Enabled = MedusaConfig.Enabled,
        Pos = {
            X = MedusaConfig.UI.MainFrame.Position.X.Scale,
            XO = MedusaConfig.UI.MainFrame.Position.X.Offset,
            Y = MedusaConfig.UI.MainFrame.Position.Y.Scale,
            YO = MedusaConfig.UI.MainFrame.Position.Y.Offset
        }
    }
    if writefile then writefile(MedusaConfig.FileName, HttpService:JSONEncode(data)) end
end

local loadedData = {}
if isfile and isfile(MedusaConfig.FileName) then
    pcall(function() loadedData = HttpService:JSONDecode(readfile(MedusaConfig.FileName)) end)
end
MedusaConfig.Enabled = loadedData.Enabled or false

-- ===================== LÓGICA DE HERRAMIENTA (TU CÓDIGO) =====================
local function findMedusa(plr)
    local char = plr.Character; if not char then return nil end
    -- Busca en el personaje
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and (t.Name:lower():find("medusa") or t.Name:lower():find("head") or t.Name:lower():find("stone")) then
            return t
        end
    end
    -- Busca en la mochila
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (t.Name:lower():find("medusa") or t.Name:lower():find("head") or t.Name:lower():find("stone")) then
                return t
            end
        end
    end
    return nil
end

local function useMedusa()
    if MedusaConfig.Debounce or (tick() - MedusaConfig.LastUsed) < MEDUSA_COOLDOWN then return end
    local char = LP.Character; if not char then return end
    
    local med = findMedusa(LP)
    if med then
        MedusaConfig.Debounce = true
        if med.Parent ~= char then
            local h = char:FindFirstChildOfClass("Humanoid")
            if h then h:EquipTool(med) end
        end
        task.wait(0.05)
        pcall(function() med:Activate() end)
        MedusaConfig.LastUsed = tick()
        MedusaConfig.Debounce = false
    end
end

-- ===================== DETECCIÓN DE ANCHOR (TU FUNCIÓN) =====================
local function onAnchorChanged(part)
    return part:GetPropertyChangedSignal("Anchored"):Connect(function()
        -- Lógica exacta: si se ancla y es invisible, dispara
        if part.Anchored and part.Transparency == 1 and MedusaConfig.Enabled then 
            useMedusa() 
        end
    end)
end

local function setupMedusaLogic(char)
    for _, c in pairs(MedusaConfig.Connections) do pcall(function() c:Disconnect() end) end
    MedusaConfig.Connections = {}
    if not char then return end
    
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then table.insert(MedusaConfig.Connections, onAnchorChanged(part)) end
    end
    
    table.insert(MedusaConfig.Connections, char.DescendantAdded:Connect(function(part)
        if part:IsA("BasePart") then table.insert(MedusaConfig.Connections, onAnchorChanged(part)) end
    end))
end

-- ===================== TRACKER DE OPONENTES =====================
local function createOpponentTag(player)
    local char = player.Character or player.CharacterAdded:Wait()
    local head = char:WaitForChild("Head", 10)
    if not head then return end
    
    local old = head:FindFirstChild("MedusaTrackerTag")
    if old then old:Destroy() end

    local bg = Instance.new("BillboardGui", head)
    bg.Name = "MedusaTrackerTag"; bg.Size = UDim2.new(0, 200, 0, 50); bg.StudsOffset = Vector3.new(0, 4, 0); bg.AlwaysOnTop = true

    local lbl = Instance.new("TextLabel", bg)
    lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 35; lbl.TextColor3 = Color3.fromRGB(170, 0, 255)
    lbl.TextStrokeTransparency = 0; lbl.Text = ""
    return lbl
end

