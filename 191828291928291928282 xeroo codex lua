-- 🔥 1. SISTEMA DE RE-SKIN Y COLORES (PARA NOVA)
task.spawn(function()
    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")

    local NOMBRE_NUEVO = "Xero Apex hub"
    local DISCORD_TUYO = "discord.gg/GfbPeZrzhN"

    local COLORS = {
        Background = Color3.fromRGB(12, 12, 15),
        ButtonDark = Color3.fromRGB(25, 25, 30),
        AccentBlue = Color3.fromRGB(0, 140, 255),
        TextWhite = Color3.fromRGB(240, 240, 240)
    }

    local function lockStyle(v)
        if v:FindFirstAncestor("RobloxGui") or v:FindFirstAncestor("Chat") or v:FindFirstAncestor("MarcaXero") then
            return 
        end

        local function apply()
            pcall(function()
                if v:IsA("TextLabel") or v:IsA("TextButton") then
                    local t = v.Text or ""
                    if (t:find("Nova") or t:find("nova")) and not t:find("Xero") then
                        local newText = t:gsub("Nova hub", NOMBRE_NUEVO)
                        newText = newText:gsub("Nova Hub", NOMBRE_NUEVO)
                        newText = newText:gsub("Nova", NOMBRE_NUEVO)
                        if v.Text ~= newText then v.Text = newText end
                    end
                    if t:find("discord.gg") and not t:find(DISCORD_TUYO) then
                        v.Visible = false
                    end
                    if v:IsA("TextButton") or v.Parent.Name:find("Top") or v.Parent.Name:find("Bar") then
                        v.TextColor3 = COLORS.TextWhite
                    end
                end

                if v:IsA("GuiObject") and v:FindFirstAncestorOfClass("ScreenGui") then
                    if v.BackgroundColor3.b > 0.5 and v.BackgroundColor3.r < 0.5 then
                        if v:IsA("Frame") or v:IsA("ScrollingFrame") then
                            v.BackgroundColor3 = COLORS.Background
                        elseif v:IsA("TextButton") or v:IsA("ImageButton") then
                            v.BackgroundColor3 = COLORS.ButtonDark
                            local s = v:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", v)
                            s.Color = COLORS.AccentBlue
                        end
                    end
                end
            end)
        end

        if v:IsA("GuiObject") then
            v:GetPropertyChangedSignal("BackgroundColor3"):Connect(apply)
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                v:GetPropertyChangedSignal("Text"):Connect(apply)
            end
        end
        apply()
    end

    game.DescendantAdded:Connect(function(obj) task.defer(function() lockStyle(obj) end) end)
    for _, v in ipairs(CoreGui:GetDescendants()) do lockStyle(v) end

    -- 🚀 EJECUTAR NOVA
    loadstring(game:HttpGet("https://raw.githubusercontent.com/p807209-alt/Scripts-trading/refs/heads/main/Orrxl4%20Hub%20versi%C3%B3n%20Xero%20v2%20xlua"))()

    -- 💎 MARCA PERSONAL
    local gui = Instance.new("ScreenGui", CoreGui)
    gui.Name = "MarcaXero"
    local text = Instance.new("TextLabel", gui)
    text.Size = UDim2.new(0, 300, 0, 25)
    text.Position = UDim2.new(0.5, -150, 0.4, 0)
    text.BackgroundTransparency = 1
    text.Text = DISCORD_TUYO
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 18
    local stroke = Instance.new("UIStroke", text)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(0,0,0)
end)

task.spawn(function()
-- AUTO MEDUSA ULTIMATE (Detección por Sonido Real + Limpieza)

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LP = Players.LocalPlayer

-- === LIMPIEZA PARA EVITAR DUPLICADOS ===
if CoreGui:FindFirstChild("MedusaProUI") then 
    CoreGui:FindFirstChild("MedusaProUI"):Destroy() 
end

-- ===================== CONFIGURACIÓN Y CONSTANTES =====================
local MEDUSA_COOLDOWN = 25
local MedusaConfig = {
    Enabled = false,
    UI = nil,
    LastUsed = 0,
    Debounce = false,
    FileName = "Kawatan_MedusaMaster.json",
    Opponents = {},
    Connections = {}
}

-- ===================== GUARDADO DE ESTADO =====================
local function SaveConfig()
    if not MedusaConfig.UI then return end
    local data = {
        Enabled = MedusaConfig.Enabled,
        Pos = {
            X = MedusaConfig.UI.MainFrame.Position.X.Scale,
            XO = MedusaConfig.UI.MainFrame.Position.X.Offset,
            Y = MedusaConfig.UI.MainFrame.Position.Y.Scale,
            YO = MedusaConfig.UI.MainFrame.Position.Y.Offset
        }
    }
    if writefile then writefile(MedusaConfig.FileName, HttpService:JSONEncode(data)) end
end

local loadedData = {}
if isfile and isfile(MedusaConfig.FileName) then
    pcall(function() loadedData = HttpService:JSONDecode(readfile(MedusaConfig.FileName)) end)
end
MedusaConfig.Enabled = loadedData.Enabled or false

-- ===================== LÓGICA DE HERRAMIENTA =====================
local function findMedusa(plr)
    local char = plr.Character; if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and (t.Name:lower():find("medusa") or t.Name:lower():find("head") or t.Name:lower():find("stone")) then
            return t
        end
    end
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (t.Name:lower():find("medusa") or t.Name:lower():find("head") or t.Name:lower():find("stone")) then
                return t
            end
        end
    end
    return nil
end

local function useMedusa()
    if MedusaConfig.Debounce or (tick() - MedusaConfig.LastUsed) < MEDUSA_COOLDOWN then return end
    local char = LP.Character; if not char then return end
    
    local med = findMedusa(LP)
    if med then
        MedusaConfig.Debounce = true
        if med.Parent ~= char then
            local h = char:FindFirstChildOfClass("Humanoid")
            if h then h:EquipTool(med) end
        end
        task.wait(0.05)
        pcall(function() med:Activate() end)
        MedusaConfig.LastUsed = tick()
        MedusaConfig.Debounce = false
    end
end

-- ===================== DETECCIÓN DE ANCHOR =====================
local function onAnchorChanged(part)
    return part:GetPropertyChangedSignal("Anchored"):Connect(function()
        if part.Anchored and part.Transparency == 1 and MedusaConfig.Enabled then 
            useMedusa() 
        end
    end)
end

local function setupMedusaLogic(char)
    for _, c in pairs(MedusaConfig.Connections) do pcall(function() c:Disconnect() end) end
    MedusaConfig.Connections = {}
    if not char then return end
    
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then table.insert(MedusaConfig.Connections, onAnchorChanged(part)) end
    end
    
    table.insert(MedusaConfig.Connections, char.DescendantAdded:Connect(function(part)
        if part:IsA("BasePart") then table.insert(MedusaConfig.Connections, onAnchorChanged(part)) end
    end))
end

-- ===================== TRACKER DE OPONENTES =====================
local function createOpponentTag(player)
    local char = player.Character or player.CharacterAdded:Wait()
    local head = char:WaitForChild("Head", 10)
    if not head then return end
    
    local old = head:FindFirstChild("MedusaTrackerTag")
    if old then old:Destroy() end

    local bg = Instance.new("BillboardGui", head)
    bg.Name = "MedusaTrackerTag"; bg.Size = UDim2.new(0, 200, 0, 50); bg.StudsOffset = Vector3.new(0, 4, 0); bg.AlwaysOnTop = true

    local lbl = Instance.new("TextLabel", bg)
    lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 35; lbl.TextColor3 = Color3.fromRGB(170, 0, 255)
    lbl.TextStrokeTransparency = 0; lbl.Text = ""
    return lbl
end

-- ===================== INTERFAZ BLACK PRO =====================
local function createUI()
    local sg = Instance.new("ScreenGui", CoreGui)
    sg.Name = "MedusaProUI"
    local mf = Instance.new("Frame", sg); mf.Name = "MainFrame"
    mf.Size = UDim2.new(0, 200, 0, 35); mf.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
    mf.Position = loadedData.Pos and UDim2.new(loadedData.Pos.X, loadedData.Pos.XO, loadedData.Pos.Y, loadedData.Pos.YO) or UDim2.new(0.5, -100, 0.6, 0)
    mf.Active = true; mf.Draggable = true; Instance.new("UICorner", mf); Instance.new("UIStroke", mf).Color = Color3.fromRGB(50, 150, 250)

    local CollapseBtn = Instance.new("TextButton", mf)
    CollapseBtn.Size = UDim2.new(0, 30, 0, 30); CollapseBtn.Position = UDim2.new(1, -35, 0, 2); CollapseBtn.Text = "v"; CollapseBtn.TextColor3 = Color3.new(1, 1, 1); CollapseBtn.BackgroundTransparency = 1; CollapseBtn.TextSize = 20; CollapseBtn.Font = Enum.Font.GothamBold

    local Title = Instance.new("TextLabel", mf)
    Title.Size = UDim2.new(1, -45, 0, 30); Title.Position = UDim2.new(0, 10, 0, 2); Title.Text = "Auto Medusa Pro"; Title.TextColor3 = Color3.fromRGB(80, 180, 255); Title.BackgroundTransparency = 1; Title.TextXAlignment = Enum.TextXAlignment.Left; Title.Font = Enum.Font.GothamBold

    local toggle = Instance.new("TextButton", mf)
    toggle.Size = UDim2.new(1, -20, 0, 25); toggle.Position = UDim2.new(0, 10, 0, 40)
    toggle.BackgroundColor3 = MedusaConfig.Enabled and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
    toggle.Text = MedusaConfig.Enabled and "ACTIVADO" or "DESACTIVADO"; toggle.TextColor3 = Color3.new(1, 1, 1); toggle.Font = Enum.Font.GothamBold; toggle.Visible = false; Instance.new("UICorner", toggle)

    local barBack = Instance.new("Frame", mf); barBack.Size = UDim2.new(1, -20, 0, 5); barBack.Position = UDim2.new(0, 10, 0, 75); barBack.BackgroundColor3 = Color3.fromRGB(30, 30, 35); barBack.Visible = false; Instance.new("UICorner", barBack)
    local barFill = Instance.new("Frame", barBack); barFill.Size = UDim2.new(0, 0, 1, 0); barFill.BackgroundColor3 = Color3.fromRGB(170, 0, 255); Instance.new("UICorner", barFill)

    local open = false
    CollapseBtn.MouseButton1Click:Connect(function()
        open = not open; toggle.Visible = open; barBack.Visible = open
        mf.Size = open and UDim2.new(0, 200, 0, 95) or UDim2.new(0, 200, 0, 35)
        CollapseBtn.Text = open and "^" or "v"
    end)

    toggle.MouseButton1Click:Connect(function()
        MedusaConfig.Enabled = not MedusaConfig.Enabled
        toggle.Text = MedusaConfig.Enabled and "ACTIVADO" or "DESACTIVADO"
        toggle.BackgroundColor3 = MedusaConfig.Enabled and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
        if MedusaConfig.Enabled then setupMedusaLogic(LP.Character) end
        SaveConfig()
    end)

    RunService.Heartbeat:Connect(function()
        local myDiff = tick() - MedusaConfig.LastUsed
        barFill.Size = UDim2.new(math.clamp(myDiff / MEDUSA_COOLDOWN, 0, 1), 0, 1, 0)
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
                local tag = p.Character.Head:FindFirstChild("MedusaTrackerTag")
                if tag then
                    local label = tag.TextLabel
                    local tool = findMedusa(p)
                    
                    -- DETECCIÓN POR SONIDO ACTIVO (Estado Real de Activación)
                    if tool and tool.Parent == p.Character then 
                        for _, s in ipairs(tool:GetDescendants()) do
                            if s:IsA("Sound") and s.Playing then
                                -- Si detecta sonido sonando, inicia cooldown del enemigo
                                if not MedusaConfig.Opponents[p.Name] or (tick() - MedusaConfig.Opponents[p.Name]) >= MEDUSA_COOLDOWN then
                                    MedusaConfig.Opponents[p.Name] = tick()
                                end
                            end
                        end
                    end
                    
                    local enemyLast = MedusaConfig.Opponents[p.Name]
                    if enemyLast then
                        local remaining = MEDUSA_COOLDOWN - (tick() - enemyLast)
                        if remaining > 0 then
                            label.TextColor3 = Color3.fromRGB(170, 0, 255)
                            label.Text = string.format("%.1f", remaining):gsub("%.", ",")
                        else
                            label.TextColor3 = Color3.fromRGB(0, 170, 0)
                            label.Text = "MEDUSA LISTA"
                        end
                    else
                        label.TextColor3 = Color3.fromRGB(0, 170, 0)
                        label.Text = "MEDUSA LISTA"
                    end
                else createOpponentTag(p) end
            end
        end
    end)
    mf:GetPropertyChangedSignal("Position"):Connect(SaveConfig); MedusaConfig.UI = {MainFrame = mf}
end

-- ===================== CARGA INICIAL =====================
LP.CharacterAdded:Connect(setupMedusaLogic)
if LP.Character then setupMedusaLogic(LP.Character) end

createUI()
for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then createOpponentTag(p) end end
end)

